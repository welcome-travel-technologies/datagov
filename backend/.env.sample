# Security
SECRET_KEY=your_django_secret_key_here
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Integrations
GEMINI_API_KEY=your_gemini_api_key_here

# MCP server: keys are minted per-user via
#   python manage.py create_mcp_key --email <user> --scopes catalog:read ...
# and stored (hashed) in the DB — there is no MCP_TOKEN env var.

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_SIGNING_SECRET=

# Google login and signup (OAuth client type: Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact browser-facing URL as an authorized redirect URI in Google.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback/
# Optional for one organization; required to choose a signup org when several exist.
GOOGLE_SIGNUP_ORGANIZATION_ID=

# Database Configuration (local target; production uses PROD_DB_* settings)
# Explicitly choose local or production independently of DEBUG.
DATAGOV_DATABASE_TARGET=local
DB_HOST=your_postgres_host_here
DB_USER=your_postgres_user_here
DB_PORT=5432
DB_NAME=postgres
DB_PASSWORD=your_postgres_password_here

# Admin Credentials
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=your_admin_password_here

# Document Explorer is opt-in: it indexes and stores documents (the Document Analyzer
# below answers questions about them). docker-compose.documents.yml supplies these
# from .env.documents; use this block for a standalone Django deployment.
DOCUMENT_EXPLORER_ENABLED=False
DOCUMENT_EXPLORER_API_URL=http://document-api:8788
DOCUMENT_EXPLORER_API_KEY=
DOCUMENT_EXPLORER_WORKER_TOKEN=
DOCUMENT_EXPLORER_PUBLIC_URL=https://datagov.welcomd.com
DOCUMENT_EXPLORER_STORAGE_ROOT=/app/private_documents

# Document Analyzer (luccy, the original document question engine) is opt-in.
# Only members of LUCCY_ORGANIZATION_ID (an Organization id) may use it; empty means nobody.
# LUCCY_ENABLED=False
# LUCCY_CHAT_ENABLED=False
# LUCCY_API_URL=http://luccy:8787
# LUCCY_API_KEY=
# LUCCY_ORGANIZATION_ID=
# LUCCY_STREAM_TIMEOUT=330
# LUCCY_TOOL_TIMEOUT=120
# LUCCY_MAX_ASKS_PER_HOUR=60
# luccy's sync job reads the document list (only collections every member may read) with
# this bearer token; empty turns it off. Each token must be at least 32 characters, and
# the sync and eval tokens must differ from the other two; a weak or shared one closes
# only its own endpoints (the log says why). Use `openssl rand -hex 32`, once per token.
# LUCCY_SYNC_TOKEN=
# Comparison runs (evaluation endpoints): off unless the analyzer is on and set up,
# LUCCY_EVAL_ENABLED=True and a token is set. LUCCY_EVAL_USER_ID is the user pk the
# answers run as; an active admin or Company member of LUCCY_ORGANIZATION_ID.
# LUCCY_EVAL_ENABLED=False
# LUCCY_EVAL_TOKEN=
# LUCCY_EVAL_USER_ID=
