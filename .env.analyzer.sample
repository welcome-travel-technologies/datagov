# Copy to ignored .env.analyzer (chmod 600) and fill every empty value (docs/document-analyzer.md).
# Used together with .env.documents: the analyzer reads the Document Explorer's Qdrant with
# DOCUMENT_EXPLORER_QDRANT_READ_ONLY_KEY and the sync writes it with DOCUMENT_EXPLORER_QDRANT_KEY,
# so set the read-only key there too.
# The luccy serving image the analyzer is built FROM, pinned. Production:
# ghcr.io/welcome-travel-technologies/luccy@sha256:<digest>. Local (the default): luccy:local,
# built in the luccy repository from feat/engine-whole-pages.
LUCCY_IMAGE=luccy:local
# Different random values (openssl rand -hex 32 each). DataGov's web and worker get them all;
# each luccy container only the ones it needs (see "Who holds which secret").
LUCCY_API_KEY=
LUCCY_SYNC_TOKEN=
# luccy's Gemini key (becomes SERVING_GEMINI_API_KEY in the analyzer and the comparison).
LUCCY_GEMINI_API_KEY=
# The DataGov organization (pk) whose members may use the analyzer and whose documents it reads.
LUCCY_ORGANIZATION_ID=
# Optional: the comparison run (off by default). LUCCY_EVAL_TOKEN is a third random value;
# LUCCY_EVAL_USER_ID is the DataGov user it acts as.
LUCCY_EVAL_ENABLED=False
LUCCY_EVAL_TOKEN=
LUCCY_EVAL_USER_ID=
# Optional: where luccy links uploaded documents (they have no source URL). Use DataGov's reader,
# e.g. https://datagov.example.com/knowledge/documents/{document_id}; empty = luccy's Drive search.
LUCCY_LIVE_UPLOAD_URL_TEMPLATE=
# Optional: answers at once and luccy's spend caps in USD (0 = off).
LUCCY_MAX_CONCURRENT_ANSWERS=2
LUCCY_SPEND_DAY_CAP_USD=25
LUCCY_SPEND_MONTH_CAP_USD=300
# Optional: False hides the page and the assistant tool again without removing the overlay.
# LUCCY_ENABLED=False
