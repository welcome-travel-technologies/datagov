# Optional Document Analyzer (docs/document-analyzer.md): shared/analyzer-sync.env, mode 0600.
# The analyzer-sync job only: it reads DataGov's document list and writes the luccy keys and
# luccy_kw into the engine's Qdrant. Literal KEY=value lines, no quotes.
LUCCY_SYNC_TOKEN=REPLACE_WITH_SAME_LUCCY_SYNC_TOKEN_AS_BACKEND
# The engine's Qdrant and its write key: the same values as QDRANT_URL and QDRANT_API_KEY in engine.env.
LUCCY_QDRANT_URL=http://document-vectors:6333
LUCCY_QDRANT_SYNC_API_KEY=REPLACE_WITH_SAME_QDRANT_KEY_AS_ENGINE
# Where luccy links uploaded documents (they have no source URL): DataGov's own reader.
LUCCY_LIVE_UPLOAD_URL_TEMPLATE=https://REPLACE_WITH_DATAGOV_HOST/knowledge/documents/{document_id}
# Only if engine.env names another chunk collection: the same DOCUMENT_EXPLORER_COLLECTION here.
# DOCUMENT_EXPLORER_COLLECTION=document_explorer_v1
