# Copy existing production settings first; preserve SECRET_KEY and integration keys.
# Compose reads these files literally: no quotes, shell expansion or interpolation.
SECRET_KEY=REPLACE_WITH_EXISTING_PRODUCTION_SECRET
DEBUG=False
SECURE_COOKIES=True
DJANGO_ALLOWED_HOSTS=datagov.welcomd.com,web
DATAGOV_DATABASE_TARGET=production
PROD_DB_HOST=REPLACE_WITH_EXISTING_DATABASE_HOST
PROD_DB_PORT=5432
PROD_DB_NAME=REPLACE_WITH_EXISTING_DATABASE_NAME
PROD_DB_USER=REPLACE_WITH_EXISTING_DATABASE_USER
PROD_DB_PASSWORD=REPLACE_WITH_EXISTING_DATABASE_PASSWORD
PROD_DB_SSLMODE=require
DOCUMENT_EXPLORER_ENABLED=True
DOCUMENT_EXPLORER_API_KEY=REPLACE_WITH_RANDOM_SERVICE_KEY
DOCUMENT_EXPLORER_WORKER_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_WORKER_TOKEN
DOCUMENT_EXPLORER_PUBLIC_URL=https://datagov.welcomd.com
# Copy existing model, Slack and Google OAuth configuration as needed.
GEMINI_API_KEY=REPLACE_WITH_PROVIDER_KEY
# Optional Document Analyzer (docs/document-analyzer.md), run on this VM when deployment.json
# enables it; compose.analyzer.yml then sets LUCCY_API_URL. Different random values
# (openssl rand -hex 32). DataGov holds them all; each luccy container's own file holds the
# same value of only the ones it needs (analyzer.env, analyzer-sync.env, analyzer-compare.env).
# LUCCY_EVAL_TOKEN is needed only for the comparison (LUCCY_EVAL_ENABLED=True).
# LUCCY_ENABLED=True
# LUCCY_CHAT_ENABLED=False
# LUCCY_API_KEY=REPLACE_WITH_RANDOM_LUCCY_API_KEY
# LUCCY_SYNC_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_LUCCY_SYNC_TOKEN
# LUCCY_EVAL_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_LUCCY_EVAL_TOKEN
# LUCCY_ORGANIZATION_ID=REPLACE_WITH_DATAGOV_ORGANIZATION_ID
# LUCCY_EVAL_ENABLED=False
# LUCCY_EVAL_USER_ID=REPLACE_WITH_DATAGOV_USER_ID
# LUCCY_STREAM_TIMEOUT=330
# LUCCY_TOOL_TIMEOUT=120
# LUCCY_MAX_ASKS_PER_HOUR=60
