QDRANT__SERVICE__API_KEY=REPLACE_WITH_SAME_QDRANT_KEY_AS_ENGINE
# Optional: a read-only key (searches, never writes) for the Document Analyzer's serving
# container: a different random value (openssl rand -hex 32), also LUCCY_QDRANT_API_KEY in
# analyzer.env. Unset leaves Qdrant exactly as it was.
# QDRANT__SERVICE__READ_ONLY_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_READ_ONLY_KEY
