# Optional Document Analyzer (docs/document-analyzer.md): shared/analyzer-compare.env, mode 0600.
# The analyzer-compare job only: it asks luccy (LUCCY_API_KEY) and DataGov (LUCCY_EVAL_TOKEN),
# reads DataGov's document list (LUCCY_SYNC_TOKEN) and judges with Gemini. It never touches
# Qdrant. Needed only while the comparison is on (LUCCY_EVAL_ENABLED=True in backend.env).
LUCCY_API_KEY=REPLACE_WITH_SAME_LUCCY_API_KEY_AS_BACKEND
LUCCY_EVAL_TOKEN=REPLACE_WITH_SAME_LUCCY_EVAL_TOKEN_AS_BACKEND
LUCCY_SYNC_TOKEN=REPLACE_WITH_SAME_LUCCY_SYNC_TOKEN_AS_BACKEND
# luccy's judge model (may be the same key as in analyzer.env).
SERVING_GEMINI_API_KEY=REPLACE_WITH_LUCCY_PROVIDER_KEY
