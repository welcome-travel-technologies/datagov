# Optional Document Analyzer (docs/document-analyzer.md): shared/analyzer.env, mode 0600.
# Read only when deployment.json enables the analyzer. Literal KEY=value lines, no quotes.
# The serving container's settings only. The sync and the comparison have their own files
# (analyzer-sync.env.example, analyzer-compare.env.example); DataGov's copy of the tokens
# goes in backend.env. deploy.py refuses a file that holds another container's secret.
LUCCY_API_KEY=REPLACE_WITH_SAME_LUCCY_API_KEY_AS_BACKEND
SERVING_GEMINI_API_KEY=REPLACE_WITH_LUCCY_PROVIDER_KEY
# The engine's Qdrant: the same URL as QDRANT_URL in engine.env, and the read-only key
# (QDRANT__SERVICE__READ_ONLY_API_KEY in qdrant.env; with managed Qdrant, a read-only key made
# in the cluster). Without a read-only key in qdrant.env: the engine's QDRANT_API_KEY.
LUCCY_QDRANT_URL=http://document-vectors:6333
LUCCY_QDRANT_API_KEY=REPLACE_WITH_QDRANT_READ_ONLY_KEY
# Only if engine.env names another chunk collection: the same DOCUMENT_EXPLORER_COLLECTION here.
# DOCUMENT_EXPLORER_COLLECTION=document_explorer_v1
# Optional: answers at once, 1 to 3 (2 when unset; luccy's own 4 does not fit its 6 GiB limit),
# and spend caps in USD.
LUCCY_MAX_CONCURRENT_ANSWERS=2
LUCCY_SPEND_DAY_CAP_USD=25
LUCCY_SPEND_MONTH_CAP_USD=300
