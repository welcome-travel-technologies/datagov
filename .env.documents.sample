# Copy to ignored .env.documents. Use unique random service credentials.
# Production: ghcr.io/welcome-travel-technologies/document-explorer@sha256:<digest>
# Local development: build document-explorer:local from the engine repository.
DOCUMENT_EXPLORER_IMAGE=document-explorer:local
DOCUMENT_EXPLORER_API_KEY=
DOCUMENT_EXPLORER_WORKER_TOKEN=
DOCUMENT_EXPLORER_QDRANT_KEY=
# Optional: Qdrant's read-only key, a different random value (openssl rand -hex 32). The Document
# Analyzer needs it (docs/document-analyzer.md); empty leaves Qdrant as it was.
DOCUMENT_EXPLORER_QDRANT_READ_ONLY_KEY=
DOCUMENT_EXPLORER_GEMINI_API_KEY=
DOCUMENT_EXPLORER_PUBLIC_URL=https://datagov.welcomd.com
